[Unit]
Description=Velofit + BikeDB Stack
After=network-online.target
Wants=network-online.target

[Service]
# /usr/local/bin is podman-compose 1.6, the one deploy.sh uses; the distro's
# /usr/bin copy (1.0.6) does not run the stack as pod_velofit.
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/velofit
ExecStart=/usr/local/bin/podman-compose -f compose.yaml up -d
ExecStop=/usr/local/bin/podman-compose -f compose.yaml down

[Install]
WantedBy=default.target
