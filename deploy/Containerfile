# Stage 1: build. Pinned to the BUILD platform: the bundle is plain JS, so
# there is nothing to gain from running node under emulation when this is
# built on arm64 for an amd64 host.
FROM --platform=$BUILDPLATFORM docker.io/library/node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

# Stage 2: serve
FROM docker.io/library/caddy:2-alpine
COPY --from=build /app/dist /usr/share/caddy
COPY deploy/Caddyfile /etc/caddy/Caddyfile
